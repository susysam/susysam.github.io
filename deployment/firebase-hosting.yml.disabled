# Inert template. Only move into .github/workflows after explicit approval and secret setup.
name: Deploy Firebase Hosting
on:
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: firebase-hosting-production
  cancel-in-progress: false
jobs:
  deploy:
    runs-on: ubuntu-latest
    environment: firebase-production
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - name: Check and build
        run: |
          node tests/check-scripts.cjs
          node --test tests/*.test.mjs
          node tests/verify-changes.cjs
          node scripts/build-site.mjs
      - uses: FirebaseExtended/action-hosting-deploy@v0
        with:
          firebaseServiceAccount: ${{ secrets.FIREBASE_SERVICE_ACCOUNT_SUSYSAM_2AE6E }}
          projectId: susysam-2ae6e
          channelId: live
